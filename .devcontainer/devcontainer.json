{
  "name": "Angularflow",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "remoteUser": "node",
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "Angular development server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm --prefix frontend ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "Angular.ng-template"
      ]
    }
  }
}